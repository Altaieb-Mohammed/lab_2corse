    "\n",
    "for name, model in MODELS:\n",
    "    t0 = time.time()\n",
    "    model.fit(X_train_s, y_train)\n",
    "    elapsed = time.time() - t0\n",
    "\n",
    "    y_pred = model.predict(X_val_s)\n",
    "    mae  = mean_absolute_error(y_val, y_pred)\n",
