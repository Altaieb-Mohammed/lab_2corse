    "## Step 3 — Generate Dataset (21,590 cases)\n",
    "Mirrors the dissertation dataset: 13 features, diverse scenarios, Awl/Radd/Hajb cases included."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import random\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "random.seed(42)\n",
    "np.random.seed(42)\n",
    "\n",
    "# ── Feature columns (13 features as in dissertation Table 9) ─────\n",
    "FEATURES = [\n",
    "    'estate', 'debts',\n",
    "    'husband', 'wife',\n",
    "    'father', 'mother',\n",
    "    'sons', 'daughters',\n",
    "    'grandfather', 'grandmother',\n",
    "    'grandsons', 'granddaughters',\n",
    "    'sisters_m',  # maternal half-sisters\n",
    "]\n",
    "TARGET = 'row_sum_shares'\n",
    "\n",
    "def ri(lo, hi): return random.randint(lo, hi)\n",
    "def rb(): return random.random() > 0.5\n",
    "\n",
    "SCENARIOS = [\n",
    "    # (name, weight, generator)\n",
    "    ('spouse_only',         1.0, lambda g: ({'wife':1} if g=='male' else {'husband':1})),\n",
    "    ('spouse_sons',         1.5, lambda g: ({('wife' if g=='male' else 'husband'):1, 'son':ri(1,3)})),\n",
    "    ('spouse_daughters',    1.5, lambda g: ({('wife' if g=='male' else 'husband'):1, 'daughter':ri(1,3)})),\n",
    "    ('spouse_mixed',        1.5, lambda g: ({('wife' if g=='male' else 'husband'):1, 'son':ri(1,2), 'daughter':ri(1,2)})),\n",
    "    ('nuclear_parents',     2.0, lambda g: ({('wife' if g=='male' else 'husband'):1, 'son':ri(0,2), 'daughter':ri(0,2), 'father':1, 'mother':1})),\n",
    "    ('parents_only',        1.0, lambda g: ({'father':1, 'mother':1})),\n",
    "    ('sons_only',           1.0, lambda g: ({'son':ri(1,4)})),\n",
    "    ('daughters_only',      1.0, lambda g: ({'daughter':ri(1,4)})),\n",
    "    ('full_siblings',       0.8, lambda g: ({'brother':ri(0,2), 'sister':ri(0,2)} or {'brother':1})),\n",
    "    ('awl_classic',         0.5, lambda g: ({'husband':1, 'daughter':2, 'mother':1})),\n",
    "    ('awl_variant',         0.5, lambda g: ({'husband':1, 'daughter':ri(1,3), 'sister':ri(1,2)})),\n",
    "    ('radd_classic',        0.5, lambda g: ({'daughter':1, 'mother':1})),\n",
    "    ('radd_variant',        0.5, lambda g: ({'daughter':ri(1,3), 'mother':1})),\n",
    "    ('blocking_hajb',       0.8, lambda g: ({'father':1, 'mother':1, 'son':1, 'brother':ri(1,2)})),\n",
    "    ('grandparents',        0.5, lambda g: ({'grandfather':1, 'grandmother':rb()})),\n",
    "    ('grandchildren',       0.5, lambda g: ({'grandsons':ri(0,2), 'granddaughters':ri(0,2), 'mother':rb()})),\n",
    "    ('maternal_siblings',   0.5, lambda g: ({'sisters_m':ri(1,3)})),\n",
    "    ('complex',             1.5, lambda g: ({'wife':1, 'son':ri(1,2), 'daughter':ri(0,2), 'father':1, 'mother':1})),\n",
    "]\n",
    "\n",
    "weights = [s[1] for s in SCENARIOS]\n",
    "total_w = sum(weights)\n",
    "\n",
    "def generate_dataset(n=21590, seed=42):\n",
    "    random.seed(seed)\n",
    "    records = []\n",
    "    seen = set()\n",
    "    attempts = 0\n",
    "\n",
    "    print(f'Generating {n:,} cases...')\n",
    "\n",
    "    while len(records) < n and attempts < n * 8:\n",
    "        attempts += 1\n",
    "        gender = random.choice(['male', 'female'])\n",
    "        sc = random.choices(SCENARIOS, weights=weights, k=1)[0]\n",
    "\n",
    "        try:\n",
    "            raw_heirs = sc[2](gender)\n",
    "            # Map feature names to heir types\n",
    "            heirs = {}\n",
    "            if raw_heirs.get('son',0):    heirs['son']    = raw_heirs['son']\n",
    "            if raw_heirs.get('daughter',0): heirs['daughter'] = raw_heirs['daughter']\n",
    "            if raw_heirs.get('wife',0):   heirs['wife']   = 1\n",
    "            if raw_heirs.get('husband',0): heirs['husband'] = 1\n",
    "            if raw_heirs.get('father',0): heirs['father'] = 1\n",
    "            if raw_heirs.get('mother',0): heirs['mother'] = 1\n",
    "            if raw_heirs.get('grandfather',0): heirs['grandfather'] = 1\n",
    "            if raw_heirs.get('grandmother',0): heirs['grandmother'] = 1\n",
    "            if raw_heirs.get('grandsons',0): heirs['son_of_son'] = raw_heirs['grandsons']\n",
    "            if raw_heirs.get('granddaughters',0): heirs['daughter_of_son'] = raw_heirs['granddaughters']\n",
    "            if raw_heirs.get('sisters_m',0): heirs['half_sister_mother'] = raw_heirs['sisters_m']\n",
    "            if raw_heirs.get('brother',0): heirs['brother'] = raw_heirs['brother']\n",
    "            if raw_heirs.get('sister',0): heirs['sister'] = raw_heirs['sister']\n",
    "\n",
    "            if not heirs: continue\n",
    "\n",
    "            # Estate values — uniform in 50K–200K as in dissertation Table 7\n",
    "            estate = random.randint(50003, 199996)\n",
    "            debts  = random.randint(2555, min(59651, int(estate * 0.40)))\n",
    "\n",
    "            result = calculate_inheritance(gender, heirs, estate, debts)\n",
    "            if not result['heir_results']: continue\n",
    "\n",
    "            key = f\"{gender}|{sorted(heirs.items())}|{estate}\"\n",
    "            if key in seen: continue\n",
    "            seen.add(key)\n",
    "\n",
    "            # Build flat feature row (13 features)\n",
    "            row = {\n",
    "                'estate':       estate,\n",
    "                'debts':        debts,\n",
    "                'husband':      heirs.get('husband', 0),\n",
    "                'wife':         heirs.get('wife', 0),\n",
    "                'father':       heirs.get('father', 0),\n",
    "                'mother':       heirs.get('mother', 0),\n",
    "                'sons':         heirs.get('son', 0),\n",
    "                'daughters':    heirs.get('daughter', 0),\n",
    "                'grandfather':  heirs.get('grandfather', 0),\n",
    "                'grandmother':  heirs.get('grandmother', 0),\n",
    "                'grandsons':    heirs.get('son_of_son', 0),\n",
    "                'granddaughters': heirs.get('daughter_of_son', 0),\n",
    "                'sisters_m':    heirs.get('half_sister_mother', 0),\n",
    "                'row_sum_shares': result['row_sum_shares'],\n",
    "                # Metadata\n",
    "                '_gender':      gender,\n",
    "                '_scenario':    sc[0],\n",
    "                '_special':     '|'.join(result['special_cases']),\n",
    "                '_net_estate':  result['net_estate'],\n",
    "            }\n",
    "            records.append(row)\n",
    "\n",
    "            if len(records) % 5000 == 0:\n",
    "                print(f'  {len(records):,} / {n:,}')\n",
    "\n",
    "        except Exception as e:\n",
    "            continue\n",
    "\n",
    "    df = pd.DataFrame(records)\n",
    "    print(f'✅ Generated {len(df):,} unique cases')\n",
    "    return df\n",
    "\n",
    "df = generate_dataset(n=21590)\n",
    "df.to_csv('inheritance_dataset_21590.csv', index=False)\n",
    "\n",
    "print(f'\\nShape: {df.shape}')\n",
    "print(f'\\nFirst 5 rows (dissertation Table 5 format):')\n",
    "print(df[FEATURES + [TARGET]].head())"
   ]
  },
