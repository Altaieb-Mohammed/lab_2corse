    "## Step 9 — Auto-Retraining System (Chapter 2.8)\n",
    "Automatic retraining when new data arrives or performance degrades."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class AutoRetrainingSystem:\n",
    "    \"\"\"\n",
    "    Automatic model retraining system (dissertation Chapter 2.8).\n",
    "    Monitors MAE threshold and retrains when performance degrades.\n",
    "    \"\"\"\n",
    "    def __init__(self, model, scaler, mae_threshold=200, version=1):\n",
    "        self.model         = model\n",
    "        self.scaler        = scaler\n",
    "        self.mae_threshold = mae_threshold\n",
    "        self.version       = version\n",
    "        self.history       = []  # performance log per version\n",
    "        print(f'✅ AutoRetraining system initialized (MAE threshold: {mae_threshold})')\n",
    "\n",
    "    def evaluate(self, X, y):\n",
    "        X_s = self.scaler.transform(X)\n",
    "        pred = self.model.predict(X_s)\n",
    "        mae = mean_absolute_error(y, pred)\n",
    "        r2  = r2_score(y, pred)\n",
    "        return mae, r2\n",
    "\n",
    "    def add_new_data(self, X_new, y_new, X_existing, y_existing):\n",
    "        \"\"\"Check if retraining needed, retrain if so.\"\"\"\n",
    "        mae, r2 = self.evaluate(X_new, y_new)\n",
    "        print(f'\\n[v{self.version}] Performance on new data: MAE={mae:.2f}, R²={r2:.5f}')\n",
    "\n",
    "        self.history.append({\n",
    "            'version': self.version,\n",
    "            'mae': mae, 'r2': r2,\n",
    "            'retrained': mae > self.mae_threshold\n",
    "        })\n",
    "\n",
    "        if mae > self.mae_threshold:\n",
    "            print(f'  ⚠️  MAE {mae:.2f} > threshold {self.mae_threshold} → Retraining...')\n",
    "            X_combined = np.vstack([X_existing, X_new])\n",
    "            y_combined = np.concatenate([y_existing, y_new])\n",
    "\n",
    "            self.scaler = StandardScaler()\n",
    "            X_s = self.scaler.fit_transform(X_combined)\n",
    "            self.model = Ridge(alpha=1.0)\n",
    "            self.model.fit(X_s, y_combined)\n",
    "\n",
    "            mae_new, r2_new = self.evaluate(X_new, y_new)\n",
    "            self.version += 1\n",
    "            print(f'  ✅ Retrained v{self.version}: MAE={mae_new:.2f}, R²={r2_new:.5f}')\n",
    "        else:\n",
    "            print(f'  ✅ Performance acceptable — no retraining needed')\n",
    "\n",
    "    def dashboard(self):\n",
    "        print('\\n── Performance Dashboard ─────────────────────────────────')\n",
    "        print(f'{\"Version\":<10} {\"MAE\":>8} {\"R²\":>10} {\"Retrained\"}')\n",
    "        for h in self.history:\n",
    "            print(f'  v{h[\"version\"]:<8} {h[\"mae\"]:>8.2f} {h[\"r2\"]:>10.5f}  {\"Yes\" if h[\"retrained\"] else \"No\"}')\n",
    "\n",
    "# ── Demo: Auto-retraining with simulated new data ─────────────────\n",
    "auto_system = AutoRetrainingSystem(best_model, scaler, mae_threshold=200)\n",
    "\n",
    "# Simulate new batch arriving\n",
    "df_new = generate_dataset(n=500, seed=99)\n",
    "X_new = df_new[FEATURES].values\n",
    "y_new = df_new[TARGET].values\n",
    "\n",
    "auto_system.add_new_data(X_new, y_new, X_train, y_train)\n",
    "auto_system.dashboard()"
   ]
  },
