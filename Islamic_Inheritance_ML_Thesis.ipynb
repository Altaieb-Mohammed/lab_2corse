   "source": [
    "## Step 2 — Sharia Rule Engine (Deterministic)\n",
    "This is the heart of the system. It calculates inheritance shares with 100% accuracy according to Islamic Fiqh (Faraid)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from fractions import Fraction\n",
    "\n",
    "def calculate_inheritance(deceased_gender, heirs, estate=100000, debts=0, will_value=0):\n",
    "    \"\"\"\n",
    "    Deterministic Sharia-compliant inheritance calculator.\n",
    "    \n",
    "    Parameters:\n",
    "        deceased_gender : 'male' or 'female'\n",
    "        heirs           : dict {heir_type: count}\n",
    "        estate          : total estate value\n",
    "        debts           : total debts\n",
    "        will_value      : will (max 1/3 of estate)\n",
    "    \n",
    "    Returns:\n",
    "        dict with full calculation details\n",
    "    \"\"\"\n",
    "    special_cases = []\n",
    "    will_value = min(will_value, estate / 3)  # Will cannot exceed 1/3\n",
    "    net_estate = estate - debts - will_value\n",
    "\n",
    "    def h(t): return heirs.get(t, 0)\n",
    "\n",
    "    has_children   = h('son') > 0 or h('daughter') > 0\n",
    "    has_son_of_son = h('son_of_son') > 0\n",
    "    has_father     = h('father') > 0\n",
    "\n",
    "    ASABAH = 'asabah'  # residuary\n",
    "    shares  = {}       # heir_type -> Fraction or ASABAH\n",
    "    reasons = {}       # heir_type -> explanation string\n",
    "\n",
    "    def S(t, frac, reason):\n",
    "        if h(t) > 0:\n",
    "            shares[t]  = frac\n",
    "            reasons[t] = reason\n",
    "\n",
    "    # ── Spouse ───────────────────────────────────────────────────\n",
    "    if deceased_gender == 'male':\n",
    "        if h('wife'):\n",
    "            S('wife', Fraction(1,8) if (has_children or has_son_of_son) else Fraction(1,4),\n",
    "              '1/8 (with children)' if (has_children or has_son_of_son) else '1/4 (no children)')\n",
    "    else:\n",
    "        if h('husband'):\n",
    "            S('husband', Fraction(1,4) if (has_children or has_son_of_son) else Fraction(1,2),\n",
    "              '1/4 (with children)' if (has_children or has_son_of_son) else '1/2 (no children)')\n",
    "\n",
    "    # ── Parents ──────────────────────────────────────────────────\n",
    "    if has_father:\n",
    "        if has_children or has_son_of_son:\n",
    "            S('father', Fraction(1,6), '1/6 (with children)')\n",
    "        else:\n",
    "            S('father', ASABAH, 'Asabah (residuary, no children)')\n",
    "\n",
    "    if h('mother'):\n",
    "        sibs = h('brother') + h('sister') + h('half_brother_father') + h('half_sister_father')\n",
    "        if has_children or has_son_of_son:\n",
    "            S('mother', Fraction(1,6), '1/6 (with children)')\n",
    "        elif sibs >= 2:\n",
    "            S('mother', Fraction(1,6), '1/6 (with 2+ siblings — Umariyyatain)')\n",
    "        else:\n",
    "            S('mother', Fraction(1,3), '1/3 (no children, fewer than 2 siblings)')\n",
    "\n",
    "    # ── Children ─────────────────────────────────────────────────\n",
    "    son_n = h('son'); dau_n = h('daughter')\n",
    "    if son_n > 0:\n",
    "        S('son', ASABAH, 'Asabah (2:1 ratio with daughters)')\n",
    "        if dau_n > 0:\n",
    "            S('daughter', ASABAH, 'Asabah with brothers (1 unit vs 2)')\n",
    "    elif dau_n > 0:\n",
    "        S('daughter', Fraction(1,2) if dau_n == 1 else Fraction(2,3),\n",
    "          '1/2 (sole daughter)' if dau_n == 1 else '2/3 (2+ daughters)')\n",
    "\n",
    "    # ── Full Siblings ─────────────────────────────────────────────\n",
    "    if not (has_father or has_children or has_son_of_son):\n",
    "        bro_n = h('brother'); sis_n = h('sister')\n",
    "        if bro_n > 0:\n",
    "            S('brother', ASABAH, 'Asabah (2:1 with sisters)')\n",
    "            if sis_n: S('sister', ASABAH, 'Asabah with brothers')\n",
    "        elif sis_n > 0:\n",
    "            S('sister', Fraction(1,2) if sis_n==1 else Fraction(2,3),\n",
    "              '1/2 (sole sister)' if sis_n==1 else '2/3 (2+ sisters)')\n",
    "\n",
    "        # Paternal half-siblings\n",
    "        hbf = h('half_brother_father'); hsf = h('half_sister_father')\n",
    "        if hbf:\n",
    "            S('half_brother_father', ASABAH, 'Asabah (paternal half-sibling)')\n",
    "            if hsf: S('half_sister_father', ASABAH, 'Asabah with half-brother')\n",
    "        elif hsf:\n",
    "            S('half_sister_father', Fraction(1,2) if hsf==1 else Fraction(2,3),\n",
    "              '1/2 (sole paternal half-sister)' if hsf==1 else '2/3 (2+)')\n",
    "\n",
    "        # Maternal half-siblings (uterine)\n",
    "        hbm = h('half_brother_mother'); hsm = h('half_sister_mother')\n",
    "        total_uterine = hbm + hsm\n",
    "        if total_uterine == 1:\n",
    "            t = 'half_brother_mother' if hbm else 'half_sister_mother'\n",
    "            S(t, Fraction(1,6), '1/6 (single uterine sibling)')\n",
    "        elif total_uterine > 1:\n",
    "            if hbm: S('half_brother_mother', Fraction(1,3), '1/3 shared (uterine siblings)')\n",
    "            if hsm: S('half_sister_mother',  Fraction(1,3), '1/3 shared (uterine siblings)')\n",
    "\n",
    "    else:\n",
    "        blocked = [t for t in ['brother','sister','half_brother_father','half_sister_father'] if h(t)]\n",
    "        if blocked:\n",
    "            reason = 'father' if has_father else 'children'\n",
    "            special_cases.append(f'Hajb (blocking): {\", \".join(blocked)} blocked by {reason}')\n",
    "\n",
    "    # ── Grandparents ─────────────────────────────────────────────\n",
    "    if not has_father and h('grandfather'):\n",
    "        S('grandfather', Fraction(1,6), '1/6 (no father)')\n",
    "    elif has_father and h('grandfather'):\n",
    "        special_cases.append('Hajb: grandfather blocked by father')\n",
    "\n",
    "    if not h('mother') and h('grandmother'):\n",
    "        S('grandmother', Fraction(1,6), '1/6 (no mother)')\n",
    "    elif h('mother') and h('grandmother'):\n",
    "        special_cases.append('Hajb: grandmother blocked by mother')\n",
    "\n",
    "    # ── Grandchildren ─────────────────────────────────────────────\n",
    "    if not (son_n > 0):\n",
    "        sos = h('son_of_son'); dos = h('daughter_of_son')\n",
    "        if sos:\n",
    "            S('son_of_son', ASABAH, 'Asabah (in absence of son)')\n",
    "            if dos: S('daughter_of_son', ASABAH, 'Asabah with son_of_son')\n",
    "        elif dos:\n",
    "            S('daughter_of_son', Fraction(1,2) if dos==1 else Fraction(2,3),\n",
    "              '1/2 (sole daughter of son)' if dos==1 else '2/3')\n",
    "\n",
    "    # ── Calculate totals ─────────────────────────────────────────\n",
    "    fixed_total = Fraction(0)\n",
    "    for t, frac in shares.items():\n",
    "        if frac != ASABAH:\n",
    "            fixed_total += frac\n",
    "\n",
    "    has_asabah = any(f == ASABAH for f in shares.values())\n",
    "\n",
    "    # ── Awl (proportional reduction when shares > 1) ──────────────\n",
    "    if fixed_total > 1 and not has_asabah:\n",
    "        special_cases.append(f'Awl applied: fixed shares sum = {float(fixed_total)*100:.2f}%')\n",
    "        scale = Fraction(1) / fixed_total\n",
    "        shares = {t: (f * scale if f != ASABAH else ASABAH) for t, f in shares.items()}\n",
    "        fixed_total = Fraction(1)\n",
    "\n",
    "    # ── Radd (reversion when shares < 1, no asabah) ──────────────\n",
    "    remaining = Fraction(1) - fixed_total\n",
    "    if remaining > 0 and not has_asabah and fixed_total > 0:\n",
    "        special_cases.append(f'Radd applied: {float(remaining)*100:.2f}% returned proportionally')\n",
    "\n",
    "    # ── Asabah distribution ───────────────────────────────────────\n",
    "    MALE_ASABAH = {'son','father','brother','half_brother_father','grandfather','son_of_son','uncle','nephew'}\n",
    "    asabah_heirs = [t for t, f in shares.items() if f == ASABAH]\n",
    "    asabah_units = sum(\n",
    "        h(t) * 2 if t in MALE_ASABAH else h(t)\n",
    "        for t in asabah_heirs\n",
    "    )\n",
    "\n",
    "    # ── Build results ─────────────────────────────────────────────\n",
    "    heir_results = []\n",
    "    total_distributed = 0.0\n",
    "\n",
    "    for t, frac in shares.items():\n",
    "        cnt = h(t)\n",
    "        if cnt == 0: continue\n",
    "\n",
    "        if frac == ASABAH:\n",
    "            asabah_pool = float(remaining) * net_estate\n",
    "            units = cnt * 2 if t in MALE_ASABAH else cnt\n",
    "            heir_pct = (units / asabah_units * float(remaining) / cnt * 100) if asabah_units else 0\n",
    "            share_str = 'Asabah'\n",
    "            # For radd with no asabah handled above\n",
    "        else:\n",
    "            if not has_asabah and float(fixed_total) > 0:\n",
    "                scale_factor = 1.0 / float(fixed_total)\n",
    "                heir_pct = float(frac) * scale_factor / cnt * 100\n",
    "            else:\n",
    "                heir_pct = float(frac) / cnt * 100\n",
    "            share_str = str(frac)\n",
    "\n",
    "        amount = net_estate * heir_pct / 100\n",
    "        total_distributed += amount * cnt\n",
    "\n",
    "        heir_results.append({\n",
    "            'type':            t,\n",
    "            'count':           cnt,\n",
    "            'share_fraction':  share_str,\n",
    "            'percentage_each': round(heir_pct, 4),\n",
    "            'total_pct':       round(heir_pct * cnt, 4),\n",
    "            'amount_each':     round(amount, 2),\n",
    "            'total_amount':    round(amount * cnt, 2),\n",
    "            'reason':          reasons.get(t, ''),\n",
    "        })\n",
    "\n",
    "    return {\n",
    "        'deceased_gender':   deceased_gender,\n",
    "        'estate':            estate,\n",
    "        'debts':             debts,\n",
    "        'will':              will_value,\n",
    "        'net_estate':        round(net_estate, 2),\n",
    "        'total_distributed': round(total_distributed, 2),\n",
    "        'heir_results':      heir_results,\n",
    "        'special_cases':     special_cases,\n",
    "        'row_sum_shares':    round(total_distributed, 4),   # Target variable Y\n",
    "    }\n",
    "\n",
    "# ── Quick test ────────────────────────────────────────────────────\n",
    "test = calculate_inheritance(\n",
    "    'male',\n",
    "    {'wife':1, 'son':2, 'mother':1},\n",
    "    estate=100000, debts=0\n",
    ")\n",
    "print('✅ Rule Engine test:')\n",
    "print(f\"Net estate: {test['net_estate']:,.2f}\")\n",
    "for hr in test['heir_results']:\n",
    "    print(f\"  {hr['type']:<20} {hr['share_fraction']:>8}  {hr['percentage_each']:>7.3f}%  ${hr['amount_each']:>10,.2f}\")\n",
    "if test['special_cases']:\n",
    "    print(f\"Special: {test['special_cases']}\")"
   ]
